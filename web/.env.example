# Browser TCP execution:
# - connector: required for Vercel/cloud (browser -> 127.0.0.1 connector)
# - server: original local Next.js server -> Zebra TCP socket
# - omit for auto (connector on hosted origins, server on localhost)
# Set this to connector in Vercel. Leave it unset for local auto-detection.
# NEXT_PUBLIC_TCP_EXECUTION=connector

# Optional versioned connector download URLs. Defaults point to /public/agent.
# For production, use signed artifacts from a GitLab Release or company CDN.
NEXT_PUBLIC_AGENT_WINDOWS_URL=
NEXT_PUBLIC_AGENT_MACOS_ARM64_URL=
NEXT_PUBLIC_AGENT_MACOS_X64_URL=

# Optional company-wide connector default. Use a private IP for direct HTTP
# site mode, or an exact HTTPS origin backed by a trusted TLS reverse proxy.
# NEXT_PUBLIC_PRINT_CONNECTOR_URL=https://zebra-gateway.company.internal

# Disable analytics by leaving this unset for an internal company deployment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloud safety switches. Set these on a generic cloud platform. Vercel sets
# VERCEL=1 automatically and hard-disables server-side TCP regardless.
# NEXTWAVES_DEPLOYMENT_MODE=cloud
# NEXTWAVES_SERVER_TCP=disabled
# Used only by an explicitly enabled local standalone server.
NEXTWAVES_SERVER_TCP_PORTS=9100
# Optional comma-separated destination allowlist for local/Docker mode.
# NEXTWAVES_SERVER_TCP_HOSTS=192.168.50.50

# The legacy file/in-memory integration API is intentionally disabled in
# cloud mode. Only enable it after adding durable profile/job storage.
# NEXTWAVES_ENABLE_INTEGRATION_API=false
NEXTWAVES_INTEGRATION_API_KEY=
NEXTWAVES_INTEGRATION_ALLOWED_ORIGINS=

# Writable local/desktop persistence. Leave unset on hosted deployments.
# NEXTWAVES_DATA_DIR=C:\Users\operator\AppData\Roaming\ZbrePrinter\data
# NEXTWAVES_PRINTER_CONFIG_PATH=C:\Users\operator\AppData\Roaming\ZbrePrinter\data\printer-routing.json
# NEXTWAVES_PROFILE_DIR=C:\Users\operator\AppData\Roaming\ZbrePrinter\data\integration-profiles
# NEXTWAVES_TEMPLATE_ROOT=C:\Program Files\ZbrePrinter\resources\web\template

{
  "name": "zbre-printer",
  "version": "3.9.2",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev -p 8888",
    "build": "next build",
    "start": "node scripts/start-8888.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:rotation": "node scripts/test-rotation.cjs",
    "test:dpi-preflight": "node scripts/test-dpi-preflight.cjs",
    "test:print-calibration": "node scripts/test-print-calibration.cjs",
    "test:qr-sizing": "node scripts/test-qr-sizing.cjs",
    "test:barcode": "node scripts/test-barcode.cjs",
    "test:datamatrix": "node scripts/test-datamatrix.cjs",
    "test:symbol-config": "node scripts/test-symbol-config.cjs",
    "test:tcp-retry": "node scripts/test-tcp-retry.cjs",
    "test:tcp-job-client": "node scripts/test-tcp-job-client.cjs",
    "test:tcp-job-route": "node scripts/test-tcp-job-route.cjs",
    "test:tcp-route": "node scripts/test-tcp-route.cjs",
    "test:zpl-z64": "node scripts/test-zpl-z64.cjs",
    "test:zpl-rfid": "node scripts/test-zpl-rfid.cjs",
    "test:rfid-text-suffix": "node scripts/test-rfid-text-suffix.cjs",
    "test:print-batch-data": "node scripts/test-print-batch-data.cjs",
    "test:print-row-range": "node scripts/test-print-row-range.cjs",
    "test:raw-spool-batch": "node scripts/test-raw-spool-batch.cjs",
    "test:browser-print-queue": "node scripts/test-browser-print-queue.cjs",
    "test:zebra-status": "node scripts/test-zebra-printer-status.cjs",
    "print-agent:windows": "python native/windows_print_agent.py",
    "build-agent:windows": "powershell -ExecutionPolicy Bypass -File native/build_windows_agent.ps1",
    "print-agent:connector": "go -C native/local_print_agent_go run .",
    "test-agent:connector": "go -C native/local_print_agent_go test ./...",
    "vet-agent:connector": "go -C native/local_print_agent_go vet ./...",
    "build-agent:connector": "powershell -ExecutionPolicy Bypass -File native/local_print_agent_go/build-cross-platform.ps1 -OutputDirectory public/agent",
    "smoke-agent:connector": "powershell -ExecutionPolicy Bypass -File scripts/smoke-test-connector.ps1",
    "smoke-agent:tcp-job": "node scripts/smoke-test-tcp-job-connector.cjs",
    "smoke:web": "node scripts/smoke-test-web.cjs",
    "test:zebra-drain": "node --test scripts/test-zebra-drain-barrier.cjs",
    "test:tcp-streaming": "node --test scripts/test-tcp-streaming.cjs",
    "test:print-cancel": "node --test scripts/test-print-cancel.cjs",
    "test:rfid-capture": "node scripts/test-rfid-capture.cjs",
    "test:production-roll": "node scripts/test-production-roll.cjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.562.0",
    "next": "16.2.12",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "resolutions": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
